# La integración de Neon en Vercel crea DATABASE_URL automáticamente.
DATABASE_URL=postgresql://usuario:clave@host-pooler.region.aws.neon.tech/basedatos?sslmode=require
# Usa un secreto ALEATORIO de al menos 32 caracteres. Ej: openssl rand -hex 32
APP_SECRET=CAMBIAR_POR_UN_SECRETO_LARGO_ALEATORIO_DE_MINIMO_32_CARACTERES
# Solo administradora: NO publicar ni escribir en el código.
ADMIN_USERNAME=organizador
ADMIN_PASSWORD=CAMBIAR_POR_UNA_CONTRASENA_ADMIN_MUY_LARGA
# Entregar este código de invitación solo a familiares.
INVITE_CODE=CAMBIAR_POR_UN_CODIGO_PRIVADO_DE_INSCRIPCION
